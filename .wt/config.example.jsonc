{
  // ============================================
  // 基础配置
  // ============================================

  // Terminal multiplexer: tmux (默认) 或 zellij
  "multiplexer": "tmux",

  // Session 名称
  "session_name": "my-project",

  // Claude CLI 命令（默认: claude）
  "claude_command": "claude",

  // Worktree 目录
  "worktree_dir": ".wt/worktrees",

  // ============================================
  // Hooks - 每个命令的行为定义
  // ============================================
  //
  // Agent step 支持的参数 (对应 claude CLI):
  //
  // 基础:
  //   interactive      - true=REPL模式, false=-p模式 (默认false)
  //   model            - haiku/sonnet/opus 或完整模型名 (默认sonnet)
  //   prompt           - 提示词，支持 @file 引用和 ${var} 变量
  //
  // System Prompt:
  //   system_prompt              - 替换系统提示 (--system-prompt)
  //   system_prompt_file         - 从文件加载系统提示 (--system-prompt-file)
  //   append_system_prompt       - 追加系统提示 (--append-system-prompt)
  //   append_system_prompt_file  - 从文件追加系统提示 (--append-system-prompt-file)
  //
  // Tools:
  //   tools            - 限制可用工具 (--tools)
  //   allowed_tools    - 自动批准的工具 (--allowedTools)
  //   disallowed_tools - 禁用的工具 (--disallowedTools)
  //
  // Permissions:
  //   skip_permissions - 跳过权限提示 (--dangerously-skip-permissions)
  //   permission_mode  - 权限模式: plan 等 (--permission-mode)
  //
  // Limits:
  //   max_turns        - 最大轮数 (--max-turns)
  //   max_budget_usd   - 最大预算 (--max-budget-usd)
  //
  // Session:
  //   continue         - 继续最近对话 (--continue)
  //   resume           - 恢复特定会话 (--resume)
  //
  // Input/Output:
  //   output_format    - text/json/stream-json (--output-format)
  //   input_format     - text/stream-json (--input-format)
  //
  // Other:
  //   add_dir          - 添加工作目录 (--add-dir)
  //   mcp_config       - MCP配置文件 (--mcp-config)
  //   verbose          - 详细日志 (--verbose)
  //
  // ============================================

  "hooks": {

    // wt run: 启动开发
    // 状态: Pending → Active, 阶段: → developing
    "run": [
      // 环境准备
      { "type": "script", "run": "npm install" },

      // 启动 agent（交互模式）
      {
        "type": "agent",
        "interactive": true,
        "model": "sonnet",
        "prompt": "@.wt/tasks/${task}.md 请完成这个任务",
        // 可选：添加项目特定的系统提示
        "append_system_prompt_file": ".wt/prompts/coding-guidelines.md"
      }
    ],

    // wt review: 进入审核阶段
    // 状态: * → Active → Idle, 阶段: → reviewing
    "review": [
      // 自动检查
      { "type": "script", "run": "npm run lint && npm run test" },

      // AI Code Review（非交互模式，带预算限制）
      {
        "type": "agent",
        "interactive": false,
        "model": "sonnet",
        "prompt": "Review code changes for task ${task}. Check @.wt/tasks/${task}.md",
        "append_system_prompt_file": ".wt/prompts/code-review.md",
        "max_turns": 10,
        "max_budget_usd": 1.0
      }
    ],

    // wt resume: 恢复开发
    // 状态: Idle → Active
    "resume": [
      {
        "type": "agent",
        "interactive": true,
        "model": "sonnet",
        "prompt": "Continue working on @.wt/tasks/${task}.md"
      }
    ],

    // wt complete: 完成任务 (rebase + merge)
    // 状态: * → Completed
    "complete": [
      // 最终验证
      { "type": "script", "run": "npm run build" },

      // Agent 执行 rebase 和 merge（可处理冲突）
      {
        "type": "agent",
        "interactive": false,
        "model": "sonnet",
        "prompt": "Merge task ${task} (branch: ${branch}, worktree: ${worktree}, repo: ${repo_root})",
        "append_system_prompt_file": ".wt/prompts/merge.md",
        "allowed_tools": ["Bash(git *)"],
        "max_turns": 20
      }
    ],

    // wt delete: 删除任务
    "delete": [
      { "type": "script", "run": "rm -rf node_modules/ .next/" }
    ],

    // wt reset: 重置任务
    "reset": [
      { "type": "internal", "run": "files:backup" },
      { "type": "script", "run": "rm -rf node_modules/ .next/" }
    ]
  }
}
